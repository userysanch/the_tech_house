# Configuración de la Base de Datos (copia este archivo como .env)
# NUNCA subas el archivo .env a Git (ya está en .gitignore).
DATABASE_URL=mysql+pymysql://root:tu_password@localhost/the_tech_house

# Configuración de Flask
SECRET_KEY=cambia_esta_clave_secreta
FLASK_ENV=development
FLASK_DEBUG=True

# Para scripts auxiliares (migrar_datos.py)
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=tu_password
MYSQL_DB=the_tech_house
